# ============================================================
# Daily email digest configuration template - copy to .env and fill in:
#   cp .env.example .env
# .env is excluded by .gitignore and never committed to Git
# ============================================================

# The mailbox address to watch (must exactly match the account address shown in the Mail app)
MAIL_ACCOUNT=your.name@example.com

# Timezone (IANA timezone name)
TIMEZONE=Asia/Shanghai

# ---- Language of the AI summaries ----
# en = English, zh = Simplified Chinese
SUMMARY_LANG=en

# ---- Zhipu BigModel (primary provider) ----
# Get an API key from the https://open.bigmodel.cn console
ZHIPU_API_KEY=
# The free model is fast; switch to glm-4.6 for higher-quality summaries
ZHIPU_MODEL=glm-5.3-flash
# GLM Coding Plan subscriber? Consume your plan quota (not pay-as-you-go
# balance) by uncommenting the next line (use a plan model such as glm-4.6):
# ZHIPU_STYLE=anthropic

# ---- DeepSeek (fallback provider, may stay empty) ----
# Get one at https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---- Optional: batch tuning (defaults live in config.py) ----
# BATCH_SIZE=15
# MAX_EMAILS=100
# MAX_EMAIL_CHARS=1200
# LLM_TIMEOUT=120
# LLM_RETRIES=2
