# Copy to webdemo/.env (never commit it). Hosting platforms: set these as environment variables instead.

# auto = live AI if a key is set, otherwise the offline mock model
# live = live AI only (errors are shown, never faked) | mock = offline mock only
LLM_MODE=auto

ZHIPU_API_KEY=
ZHIPU_MODEL=glm-5.3-flash
# ZHIPU_STYLE=anthropic   # GLM Coding Plan channel
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# SUMMARY_LANG=en         # en | zh
# MAX_EMAILS=60
# PORT=8000
