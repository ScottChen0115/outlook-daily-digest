# Copy to webdemo/.env (never commit it). Hosting platforms: set these as environment variables instead.

# auto = DeepSeek if DEEPSEEK_API_KEY is set, otherwise the offline mock model
# live = DeepSeek only (errors are shown, never faked) | mock = offline mock only
LLM_MODE=auto

# Get a key at https://platform.deepseek.com (API Keys page)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# SUMMARY_LANG=en         # en | zh
# MAX_EMAILS=60
# PORT=8000
